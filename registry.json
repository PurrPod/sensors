{
  "version": "2.0",
  "repository": "https://github.com/PurrPod/sensors",
  "sensors": [
    {
      "name": "feishu-bot",
      "description": "飞书机器人传感器，通过 WebSocket 长连接监听飞书群消息并支持主动下发卡片消息。",
      "enabled": true,
      "env": {
        "FEISHU_APP_ID": "",
        "FEISHU_APP_SECRET": "",
        "FEISHU_CHAT_ID": ""
      },
      "capabilities": {
        "observe": true,
        "express": true
      }
    },
    {
      "name": "rss-watcher",
      "description": "RSS 订阅观察器，按固定间隔轮询多个 RSS 源，发现新更新时推送摘要到主进程。",
      "enabled": false,
      "env": {
        "INTERVAL": "1800",
        "RSS_SUBSCRIPTIONS_JSON": "[{\"name\": \"Ahead of AI\", \"rss_url\": \"https://magazine.sebastianraschka.com/feed\"},{\"name\": \"Latepost 晚点\", \"rss_url\": \"https://rsshub.rssforever.com/latepost\"}]"
      },
      "capabilities": {
        "observe": true,
        "express": false
      }
    },
    {
      "name": "system-clock",
      "description": "系统时钟传感器，定时轮询本地 cron 配置并按规则触发闹钟提醒或启动任务图。",
      "enabled": true,
      "env": {
        "CRON_FILE": "~/.purrcat/core/cron.json"
      },
      "capabilities": {
        "observe": true,
        "express": false
      }
    }
  ]
}
